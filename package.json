{
  "name": "newcomer-companion",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke": "tsx scripts/smoke.ts",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && wrangler deploy",
    "qa:build": "opennextjs-cloudflare build --env qa",
    "qa:deploy": "wrangler deploy worker/index.ts --config wrangler.jsonc --env qa --no-autoconfig --keep-vars",
    "qa:migrate": "wrangler d1 migrations apply DB --config wrangler.jsonc --remote --env qa",
    "db:migrate": "wrangler d1 migrations apply settla-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply settla-db --local"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "next": "^16.4.3",
    "openai": "^7.45.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
