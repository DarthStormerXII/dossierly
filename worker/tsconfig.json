{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "types": ["@cloudflare/workers-types", "node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["./*.ts", "../src/lib/*.ts", "../src/lib/server/**/*.ts", "../src/lib/hub/**/*.ts", "../src/lib/model/**/*.ts", "../src/lib/mask/**/*.ts", "../src/lib/features/**/*.ts", "../open-next.config.ts"]
}
