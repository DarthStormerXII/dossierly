# Nebius Token Factory (https://tokenfactory.nebius.com/)
NEBIUS_API_KEY=
MODEL_PROVIDER=tokenfactory
# Optional: ask Token Factory for JSON mode (unverified for Nemotron; off by default)
TOKENFACTORY_JSON_MODE=0
# Only used when NEBIUS_API_KEY is absent: serve recorded fixtures (clearly labelled in the UI)
DEMO_FIXTURES=0
# "1" switches off every Token Factory call (kill switch). In production set it as a Worker secret, see docs/BUILD.md.
MODELS_DISABLED=
